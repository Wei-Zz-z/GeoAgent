# Copy to .env and fill in keys, then run with: uv run --env-file .env uvicorn ...
# Aliyun Qwen (DashScope OpenAI-compatible endpoint):
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Default model used by new conversations (must match an id in config.py)
GEOAGENT_DEFAULT_MODEL=qwen3.8-27b

# Optional: pin a cheaper model for the router agent
GEOAGENT_ROUTER_MODEL=

# Where conversations are persisted (defaults to backend/data)
GEOAGENT_DATA_DIR=

# 土地变化检测库（PostgreSQL/PostGIS，只读账号；连接局域网内服务）
GEOAGENT_PG_DSN=postgresql://user:pass@192.168.3.209:5432/land_change

# 只读白名单（逗号分隔）：图斑主表 + 图斑类型字典 + 合并地类字典视图。
# 留空则启动时自动并入 skills/qa-library/assets/datasets.json 里登记的全部期次表；
# 一旦显式配置，就以本行为准（换期次时记得同步）。
GEOAGENT_PG_WHITELIST=data."2026_1_change_landuse",data."2026_2_change_landuse",knowledge_base.dict_tblx,knowledge_base.dict_land_classification_summary

# 问答链路：先按指标匹配标准问题，未命中再走自由 SQL 兜底。
# execute=命中即确定性执行（口径与数字不经模型）；hint=只把命中口径作为提示交给模型；off=关闭。
GEOAGENT_QA_PREMATCH=execute
# 预匹配最低置信度（0-1）：低于该值就按"没命中"处理，交给自由 SQL。
# 0.42 是低风险口径的基础阈值；中/高风险阈值由 terms.json 的 risk 规则继续抬高。
GEOAGENT_QA_PREMATCH_CONFIDENCE=0.42
# 预匹配是否启用 embedding 向量召回 + RRF（1=启用，0=纯规则；无 API Key 自动降级）。
GEOAGENT_QA_VECTOR=1
# 灰度区（candidates/clarify）是否调用 LLM judge 复核候选；0=不调用。
GEOAGENT_QA_JUDGE=1

# 场景智能体开关：养老可达性评估。0=不启用（启动即不加载 geopandas/networkx
# 分析栈，常驻内存明显下降，前端智能体选择框也不会出现该选项）；1=启用。
GEOAGENT_ELDER_CARE=1

# 单次查询最大返回行数与查询超时（秒）
GEOAGENT_PG_MAX_ROWS=200
GEOAGENT_PG_TIMEOUT_S=10

# 快报等生成文件的输出目录（默认 %LOCALAPPDATA%/GeoAgent/reports，仓库外）
GEOAGENT_REPORTS_DIR=

# 可选：LibreOffice soffice 可执行文件；Windows 安装 Microsoft Word 时可留空。
GEOAGENT_PDF_CONVERTER=

# Skills directory (defaults to <project root>/skills)
GEOAGENT_SKILLS_DIR=

# SQL 智能问数向量知识库；默认 file，不需要数据库写权限。
GEOAGENT_EMBEDDING_MODEL=text-embedding-v3
GEOAGENT_EMBEDDING_BASE_URL=
GEOAGENT_VECTOR_STORE=file
# 可选：模板未可靠匹配时查询已构建的问题向量索引，额外调用 Embedding；只补候选，不自动执行。
GEOAGENT_TEMPLATE_VECTOR_MATCH=0
# 仅显式选择 pgvector 时使用；不要填写业务只读账号之外的密码到代码库。
GEOAGENT_PGVECTOR_DSN=

# 入口验证与用户体系（省域平台 2.0 ticket）
# dev=不校验（默认，保持开发联调）；ticket=校验后按登录用户隔离会话
GEOAGENT_AUTH_MODE=dev
# 省域平台 ticket 校验接口；参数名按接入文档保持 sykjzlptv2_ticket（避免与其他对接冲突）
GEOAGENT_TICKET_VALIDATE_URL=https://kjzl.zrzyt.zj.gov.cn/bev2/api/Ticket/ValidateTicket
GEOAGENT_TICKET_TIMEOUT_S=5
# 登录态有效期（秒，默认 8 小时）、Cookie 名与 Secure 开关（https 部署时置 1）
GEOAGENT_AUTH_SESSION_TTL_S=28800
GEOAGENT_AUTH_COOKIE=geoagent_session
GEOAGENT_AUTH_COOKIE_SECURE=0
# 会话签名密钥：留空则在数据目录自动生成并持久化；多实例部署必须显式配置同一个值
GEOAGENT_AUTH_SECRET=

# 会话存储：默认写 PostgreSQL（GEOAGENT_CHAT_DSN 留空则沿用上面的 GEOAGENT_PG_DSN）；
# memory 仅用于单元测试 / 未配库的本地联调（进程重启即丢失）
GEOAGENT_CHAT_STORE=postgres
GEOAGENT_CHAT_DSN=
# 会话表所在 schema（启动时自动建表，幂等）
GEOAGENT_CHAT_SCHEMA=geoagent

# MCP 对外接口（Streamable HTTP，端点 /mcp/）
# 令牌格式 <令牌>:<调用方名>，逗号分隔；由 MCP 层校验，未配置时 /mcp 一律拒绝
GEOAGENT_MCP_TOKENS=
# 快报下载链接有效期（秒，默认 1 小时）
GEOAGENT_MCP_DOWNLOAD_TTL_S=3600
# 对外基地址（配置后快报下载链接返回绝对地址）
GEOAGENT_PUBLIC_BASE_URL=
