# Copy to .env and fill in keys, then run with: uv run --env-file .env uvicorn ...
# Aliyun Qwen (DashScope OpenAI-compatible endpoint):
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Other providers (optional):
ZHIPU_API_KEY=xxxx
DEEPSEEK_API_KEY=xxxx

# Default model used by new conversations (must match an id in config.py)
GEOAGENT_DEFAULT_MODEL=qwen-flash

# Optional: pin a cheaper model for the router agent
GEOAGENT_ROUTER_MODEL=

# Where conversations are persisted (defaults to backend/data)
GEOAGENT_DATA_DIR=
