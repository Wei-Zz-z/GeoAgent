# GeoAgent 环境变量模板
# 部署到 /etc/geoagent/geoagent.env，权限 640，属主 root:geoagent
# 注意：不要在值后面写行内注释——手工 source 该文件做命令行检查时，注释会被当成值的一部分。

# —— 大模型：指向内网 OpenAI 兼容网关（不用改代码）——
OPENAI_BASE_URL=http://<内网模型网关>/v1
OPENAI_API_KEY=<网关分配的 key>
GEOAGENT_DEFAULT_MODEL=qwen3.8-27b

# —— 数据库 ——
GEOAGENT_PG_DSN=postgresql://geoagent_ro:<密码>@<库地址>:5432/land_change
GEOAGENT_CHAT_DSN=postgresql://geoagent_rw:<密码>@<库地址>:5432/geoagent_chat
GEOAGENT_CHAT_SCHEMA=geoagent
GEOAGENT_PG_WHITELIST=data."2026_1_change_landuse",data."2026_2_change_landuse",knowledge_base.dict_tblx,knowledge_base.dict_land_classification_summary
GEOAGENT_PG_MAX_ROWS=200
GEOAGENT_PG_TIMEOUT_S=10

# —— 运行时目录 ——
GEOAGENT_DATA_DIR=/opt/geoagent/data
GEOAGENT_REPORTS_DIR=/opt/geoagent/reports

# —— 入口验证 ——
# 有内网可达的票据校验地址就改 ticket，否则保持 dev（dev 模式不校验、会话不按用户隔离）
GEOAGENT_AUTH_MODE=dev
# GEOAGENT_TICKET_VALIDATE_URL=http://<内网转发地址>/bev2/api/Ticket/ValidateTicket
GEOAGENT_AUTH_SECRET=<openssl rand -base64 48 的输出>
GEOAGENT_AUTH_SESSION_TTL_S=28800
# 只用 https 访问时置 1；用 http 访问必须置 0，否则登录态存不住
GEOAGENT_AUTH_COOKIE_SECURE=0

# —— MCP 对外接口（不对外提供可留空，留空时 /mcp 一律拒绝）——
GEOAGENT_MCP_TOKENS=
GEOAGENT_PUBLIC_BASE_URL=https://<域名>
GEOAGENT_MCP_DOWNLOAD_TTL_S=3600

# —— 问答链路 ——
GEOAGENT_QA_PREMATCH=execute
GEOAGENT_QA_PREMATCH_CONFIDENCE=0.5

# —— 场景智能体开关 ——
# 养老可达性评估：0=不启用（启动阶段不再加载 geopandas/networkx 整套分析栈，
# 常驻内存可降一个数量级；前端也不会出现该选项）；1=启用
GEOAGENT_ELDER_CARE=0

# —— 可选：PDF/.doc 转换、套合删除前备份 ——
# GEOAGENT_PDF_CONVERTER=/usr/bin/soffice
# GEOAGENT_DOC_CONVERTER=/usr/bin/soffice
# GEOAGENT_PG_DUMP=/usr/pgsql-16/bin/pg_dump
